    {
      "id": "d1ca98056978cc18",
      "type": "text",
      "x": 24,
      "y": 404,
      "width": 486,
      "height": 178,
      "text": "",
      "app": {
        "entityType": "table",
        "fields": {
          "name": "account",
          "schema": "app",
          "description": "A person who signs in",
          "status": "active",
          "definition": "{\n  \"columns\": [\n    {\n      \"name\": \"id\",\n      \"type\": \"uuid\",\n      \"nullable\": false,\n      \"default\": \"gen_random_uuid()\"\n    },\n    {\n      \"name\": \"email\",\n      \"type\": \"text\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"display_name\",\n      \"type\": \"text\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"created_at\",\n      \"type\": \"timestamp with time zone\",\n      \"nullable\": false,\n      \"default\": \"now()\"\n    }\n  ],\n  \"primaryKey\": {\n    \"name\": \"account_pkey\",\n    \"columns\": [\n      \"id\"\n    ]\n  },\n  \"uniques\": [],\n  \"checks\": [\n    {\n      \"name\": \"account_email_check\",\n      \"expression\": \"POSITION('@' IN email) > 1\"\n    }\n  ],\n  \"foreignKeys\": [],\n  \"indexes\": [\n    {\n      \"name\": \"account_email_lower_key\",\n      \"unique\": true,\n      \"method\": \"btree\",\n      \"columns\": [\n        \"(lower(email))\"\n      ]\n    }\n  ]\n}"
        }
      }
    },
    {
      "id": "ea1f98f03efb55e7",
      "type": "text",
      "x": 1849,
      "y": 404,
      "width": 486,
      "height": 204,
      "text": "",
      "app": {
        "entityType": "table",
        "fields": {
          "name": "comment",
          "schema": "app",
          "description": "",
          "status": "active",
          "definition": "{\n  \"columns\": [\n    {\n      \"name\": \"id\",\n      \"type\": \"bigint\",\n      \"nullable\": true,\n      \"identity\": \"always\"\n    },\n    {\n      \"name\": \"task_id\",\n      \"type\": \"uuid\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"author_id\",\n      \"type\": \"uuid\",\n      \"nullable\": true\n    },\n    {\n      \"name\": \"body\",\n      \"type\": \"text\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"created_at\",\n      \"type\": \"timestamp with time zone\",\n      \"nullable\": false,\n      \"default\": \"now()\"\n    }\n  ],\n  \"primaryKey\": {\n    \"name\": \"comment_pkey\",\n    \"columns\": [\n      \"id\"\n    ]\n  },\n  \"uniques\": [],\n  \"checks\": [],\n  \"foreignKeys\": [\n    {\n      \"name\": \"comment_task_id_fkey\",\n      \"columns\": [\n        \"task_id\"\n      ],\n      \"references\": {\n        \"schema\": \"app\",\n        \"table\": \"task\",\n        \"columns\": [\n          \"id\"\n        ]\n      },\n      \"onDelete\": \"cascade\"\n    },\n    {\n      \"name\": \"comment_author_id_fkey\",\n      \"columns\": [\n        \"author_id\"\n      ],\n      \"references\": {\n        \"schema\": \"app\",\n        \"table\": \"account\",\n        \"columns\": [\n          \"id\"\n        ]\n      },\n      \"onDelete\": \"set_null\"\n    }\n  ],\n  \"indexes\": [\n    {\n      \"name\": \"comment_task_idx\",\n      \"unique\": false,\n      \"method\": \"btree\",\n      \"columns\": [\n        \"task_id\",\n        \"created_at\"\n      ]\n    }\n  ]\n}"
        }
      }
    },
    {
      "id": "9cd20aeb04a8225e",
      "type": "text",
      "x": 630,
      "y": 404,
      "width": 360,
      "height": 178,
      "text": "",
      "app": {
        "entityType": "table",
        "fields": {
          "name": "label",
          "schema": "app",
          "description": "",
          "status": "active",
          "definition": "{\n  \"columns\": [\n    {\n      \"name\": \"id\",\n      \"type\": \"bigint\",\n      \"nullable\": true,\n      \"identity\": \"always\"\n    },\n    {\n      \"name\": \"workspace_id\",\n      \"type\": \"uuid\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"name\",\n      \"type\": \"text\",\n      \"nullable\": false\n    },\n    {\n      \"name\": \"color\",\n      \"type\": \"text\",\n      \"nullable\": false,\n      \"default\": \"'#888888'\"\n    }\n  ],\n  \"primaryKey\": {\n    \"name\": \"label_pkey\",\n    \"columns\": [\n      \"id\"\n    ]\n  },\n  \"uniques\": [\n    {\n      \"name\": \"label_workspace_name_key\",\n      \"columns\": [\n        \"workspace_id\",\n        \"name\"\n      ]\n    }\n  ],\n  \"checks\": [],\n  \"foreignKeys\": [\n    {\n      \"name\": \"label_workspace_id_fkey\",\n      \"columns\": [\n        \"workspace_id\"\n      ],\n      \"references\": {\n        \"schema\": \"app\",\n        \"table\": \"workspace\",\n        \"columns\": [\n          \"id\"\n        ]\n      },\n      \"onDelete\": \"cascade\"\n    }\n  ],\n  \"indexes\": []\n}"
        }
      }
    },
    {
      "id": "6d33d88fe51e28a3",
      "type": "text",
      "x": 630,
