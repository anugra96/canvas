      "app": {
        "entityType": "schema",
        "fields": {
          "name": "Model Product",
          "kind": "database",
          "version": "1.0.0",
          "owner": "Tower",
          "status": "active",
          "reviewStatus": "approved",
          "reviewedVersion": "1.0.0",
          "lastReviewed": "2026-11-01",
          "reviewIntervalDays": 180,
          "source": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"Model Product\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"family\": {\n      \"type\": \"string\"\n    },\n    \"product\": {\n      \"type\": \"string\"\n    },\n    \"region_name\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"candidate\",\n        \"staged\",\n        \"production\",\n        \"retired\"\n      ]\n    },\n    \"container_id\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  },\n  \"required\": [\n    \"id\",\n    \"name\",\n    \"family\",\n    \"product\",\n    \"region_name\",\n    \"status\"\n  ]\n}"
        }
      },
      "type": "text",
      "text": "## Schema: Model Product\n- **Contract kind:** database\n- **Version:** 1.0.0\n- **Owner:** Tower\n- **Status:** active\n- **Review status:** approved\n- **Reviewed version:** 1.0.0\n- **Last reviewed:** 2026-11-01\n- **Review interval (days):** 180",
      "styleAttributes": {
        "textAlign": "center",
        "shape": "database"
      }
    },
