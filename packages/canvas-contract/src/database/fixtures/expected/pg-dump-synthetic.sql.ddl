CREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA public;

CREATE SCHEMA app;

CREATE TYPE app.member_role AS ENUM ('owner', 'editor', 'viewer');

CREATE TABLE app.event (
    id integer GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    team_id bigint NOT NULL,
    payload jsonb DEFAULT '{}'::jsonb NOT NULL,
    happened_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT event_pkey PRIMARY KEY (id)
);

CREATE TABLE app.member (
    team_id bigint NOT NULL,
    user_id text NOT NULL,
    role app.member_role DEFAULT CAST('viewer' AS app.member_role) NOT NULL,
    invited_by text,
    joined_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT member_pkey PRIMARY KEY (team_id, user_id)
);

CREATE TABLE app.team (
    id bigint GENERATED BY DEFAULT AS IDENTITY NOT NULL,
    slug text NOT NULL,
    name text,
    budget numeric(10,2) DEFAULT 0 NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    slug_upper text GENERATED ALWAYS AS (upper(slug)) STORED,
    CONSTRAINT team_pkey PRIMARY KEY (id),
    CONSTRAINT team_slug_check CHECK (char_length(slug) > 0),
    CONSTRAINT team_id_not_null CHECK (id IS NOT NULL)
);

ALTER TABLE app.event ADD CONSTRAINT event_team_id_fkey FOREIGN KEY (team_id) REFERENCES app.team (id) ON DELETE RESTRICT;

ALTER TABLE app.member ADD CONSTRAINT member_team_id_fkey FOREIGN KEY (team_id) REFERENCES app.team (id) ON DELETE CASCADE;

CREATE INDEX member_role_partial_idx ON app.member USING btree (role) WHERE role = CAST('owner' AS app.member_role);

CREATE UNIQUE INDEX member_user_team_idx ON app.member USING btree (user_id, team_id);

CREATE UNIQUE INDEX team_lower_slug_idx ON app.team USING btree ((lower(slug)));

COMMENT ON SCHEMA app IS 'Application schema';

COMMENT ON TYPE app.member_role IS 'Role inside a team.';

COMMENT ON TABLE app.team IS 'A team (tenant).';

COMMENT ON COLUMN app.team.slug IS 'URL-safe slug.';

SET statement_timeout = 0;

SET lock_timeout = 0;

SET idle_in_transaction_session_timeout = 0;

SET client_encoding = 'UTF8';

SET standard_conforming_strings = on;

SELECT pg_catalog.set_config('search_path', '', false);

SET check_function_bodies = false;

SET xmloption = content;

SET client_min_messages = warning;

SET row_security = off;

ALTER SCHEMA app OWNER TO app_owner;

ALTER TABLE app.team OWNER TO app_owner;

ALTER TABLE app.event OWNER TO app_owner;

ALTER TABLE app.member OWNER TO app_owner;

CREATE FUNCTION app.touch_team() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    NEW.created_at = now();
    RETURN NEW;
END;
$$;

ALTER FUNCTION app.touch_team() OWNER TO app_owner;

CREATE TRIGGER team_touch_trg BEFORE UPDATE ON app.team FOR EACH ROW EXECUTE FUNCTION app.touch_team();

ALTER TABLE app.team ENABLE TRIGGER team_touch_trg;
